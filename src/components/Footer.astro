---
import Socials from './Socials.astro';
import { NAV, SITE } from '../config';
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a class="logo" href="/" aria-label={`${SITE.name} — home`}>{SITE.name}</a>
      <p>{SITE.tagline}<br />Building businesses, systems and ideas that create long-term value.</p>
    </div>
    <nav class="footer__nav" aria-label="Footer">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <Socials />
  </div>
  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>
