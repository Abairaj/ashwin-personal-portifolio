# Copy to .env and fill in. Never commit .env.

# Public address of the site (no trailing slash).
SITE_URL=https://example.com

# Host name the admin area answers on. Leave empty in local development,
# where the admin is at http://localhost:4321/admin/.
ADMIN_HOST=admin.example.com

# PostgreSQL connection.
DATABASE_URL=postgres://portfolio:change-me@localhost:5432/portfolio

# The one admin account. Create the hash with: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=

# Where uploaded images are stored. On the server use a folder OUTSIDE the code
# folder (e.g. /var/lib/portfolio/uploads) so updates never touch it.
UPLOAD_DIR=./uploads

# Port and address the app listens on (nginx proxies to it).
HOST=127.0.0.1
PORT=4321
